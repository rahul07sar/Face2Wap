# Face2Wap Example Environment

APP_ENV=development

DATABASE_URL=postgresql://face2wap:face2wap@localhost:5432/face2wap

GCP_PROJECT_ID=
GCP_STORAGE_BUCKET_UPLOADS=
GCP_STORAGE_BUCKET_RESULTS=

API_PORT=8000
WORKER_PORT=8001

MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=200
MAX_VIDEO_DURATION_SECONDS=60
UPLOAD_URL_EXPIRY_MINUTES=15
VIDEO_UPLOAD_URL_EXPIRY_MINUTES=180

JOB_EXPIRY_HOURS=24
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
JOB_STATUS_RATE_LIMIT_MAX_REQUESTS=120

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://api:8000

JOB_TOKEN_SECRET=replace-with-a-long-random-private-secret
WORKER_API_TOKEN=replace-with-a-long-random-private-token
FACE_SWAP_DEVICE_ID=0
FACE_SWAP_ENGINE=facefusion

#Incluudes otional values for FaceFusion configuration, you can leave them as default or modify them as needed.
FACEFUSION_PYTHON_EXECUTABLE=python3
FACEFUSION_WORKING_DIRECTORY=/opt/facefusion
FACEFUSION_EXECUTION_PROVIDER=cpu
FACEFUSION_EXECUTION_THREAD_COUNT=4
FACEFUSION_DOWNLOAD_PROVIDERS=github
FACEFUSION_DOWNLOAD_SCOPE=lite
FACEFUSION_FACE_SWAPPER_MODEL=hyperswap_1c_256
FACEFUSION_FACE_SWAPPER_PIXEL_BOOST=512x512
FACEFUSION_ENABLE_FACE_ENHANCER=true
FACEFUSION_FACE_ENHANCER_MODEL=gfpgan_1.4
FACEFUSION_FACE_ENHANCER_BLEND=80
FACEFUSION_FACE_ENHANCER_WEIGHT=1.0
FACEFUSION_FACE_SWAPPER_WEIGHT=1.0
FACEFUSION_FACE_SELECTOR_MODE=reference
FACEFUSION_REFERENCE_FACE_POSITION=0
FACEFUSION_REFERENCE_FACE_DISTANCE=0.45
FACEFUSION_VIDEO_FACE_SWAPPER_MODEL=inswapper_128
FACEFUSION_VIDEO_FACE_SWAPPER_PIXEL_BOOST=256x256
FACEFUSION_VIDEO_FACE_SWAPPER_WEIGHT=1.0
FACEFUSION_VIDEO_FACE_SELECTOR_MODE=reference
FACEFUSION_VIDEO_REFERENCE_FACE_POSITION=0
FACEFUSION_VIDEO_REFERENCE_FACE_DISTANCE=0.45
FACEFUSION_VIDEO_ENABLE_FACE_ENHANCER=false
FACEFUSION_VIDEO_FACE_ENHANCER_MODEL=gfpgan_1.4
FACEFUSION_VIDEO_FACE_ENHANCER_BLEND=80
FACEFUSION_VIDEO_FACE_ENHANCER_WEIGHT=1.0
FACEFUSION_VIDEO_MEMORY_STRATEGY=tolerant
FACEFUSION_OUTPUT_VIDEO_ENCODER=libx264
FACEFUSION_OUTPUT_VIDEO_PRESET=ultrafast
FACEFUSION_OUTPUT_VIDEO_QUALITY=75
FACEFUSION_OUTPUT_VIDEO_SCALE=1.0
FACEFUSION_LOG_LEVEL=error
FACEFUSION_KEEP_TEMP=false
FACEFUSION_OUTPUT_IMAGE_QUALITY=95
FACEFUSION_PROCESS_TIMEOUT_SECONDS=3600
FACEFUSION_VIDEO_PROCESS_TIMEOUT_SECONDS=21600
API_TRANSFER_TIMEOUT_SECONDS=11100

WORKER_BASE_URL=http://worker:8001
WORKER_REQUEST_TIMEOUT_SECONDS=11100
